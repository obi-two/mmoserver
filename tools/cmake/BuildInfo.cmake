# Writes the build's git revision into a header for the "Running build"
# message players get at login (src/Common/BuildInfo.cc). Run on every build
# (src/Common/CMakeLists.txt) in script mode:
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P BuildInfo.cmake
#
# The header only changes when the branch, commit or local changes do, so an
# unchanged tree does not relink the servers. Without git it says "unknown".

set(revision "unknown")
set(commit_time "")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --abbrev-ref HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE branch
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r1)
    execute_process(COMMAND "${GIT_EXECUTABLE}" describe --always --dirty
        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE commit
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r2)
    execute_process(COMMAND "${GIT_EXECUTABLE}" log -1 --format=%cd --date=format:%Y-%m-%d\ %H:%M
        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE commit_time
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(r1 EQUAL 0 AND r2 EQUAL 0)
        set(revision "${branch}@${commit}")
    endif()
endif()

set(content "// Generated by tools/cmake/BuildInfo.cmake; do not edit.
#define ANH_BUILD_REVISION \"${revision}\"
#define ANH_BUILD_COMMIT_TIME \"${commit_time}\"
")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT "${old}" STREQUAL "${content}")
    file(WRITE "${OUTPUT}" "${content}")
endif()
